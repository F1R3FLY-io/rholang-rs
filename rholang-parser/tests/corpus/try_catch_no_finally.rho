// try/catch without finally. Desugars to the same shape as
// try_catch_finally.rho but with the two branches losing their
// finally-Par arm -- try-branch is just the Let body, catch-branch
// is just the Let body.
new fs, log in {
  try @[file] <- fs!openFile("path.txt") {
    log!("opened", file)
  }
  catch @[code, msg] {
    log!("error", code, msg)
  }
}
