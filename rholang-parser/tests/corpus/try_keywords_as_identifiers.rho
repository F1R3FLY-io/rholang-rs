// Regression test for backward compatibility: `try` and `catch`
// are NOT globally reserved keywords. Existing Rholang code that
// uses these as identifiers in contexts where the GLR parser can
// disambiguate (e.g., contract formals, quoted names) continues to
// parse without becoming a try_block.
//
// Process-position use (`catch!(try)`, `try!(x)`, `try(x)`) also
// parses: the grammar accepts the `try` keyword token as a `var`
// (`_contextual_keyword_var`), and GLR keeps both readings until the
// following tokens decide. See also foreach_robustness_tests.rs.
contract dispatchOnCatch(try, catch) = {
  catch!(try)
} |
contract useTryAndCatch(@try, @catch, ret) = {
  ret!((try, catch))
}
