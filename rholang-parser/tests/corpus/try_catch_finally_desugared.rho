// Hand-written equivalent of try_catch_finally.rho. Paired with the
// sugared form in tests/desugar_equivalence.rs and asserted equal
// modulo source spans.
//
// The outer `fs!openFile(...)` uses the existing method-call sugar
// (rewritten at parse time to `fs!?("openFile", ...)`), same as the
// sugared form does implicitly. The `__ok` / `__rest` names are the
// fresh internals the try_block desugaring uses; matching them here
// is what makes the AST equal.
//
// The finally body appears once inside the try branch and once inside
// the catch branch, per the FIP expansion. Each occurrence is joined
// to the branch body with `|`.
new fs, log in {
  for (@[__ok, ...__rest] <- fs!?("openFile", "path.txt")) {
    if (__ok) {
      let @[file] <- __rest in {
        log!("opened", file) | log!("done")
      }
    } else {
      let @[code, msg] <- __rest in {
        log!("error", code, msg) | log!("done")
      }
    }
  }
}
